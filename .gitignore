# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (matches dotfiles AND names like roma.env.local, which the previous pattern missed)
.env*
*.env*
*.local

# database
*.db

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts